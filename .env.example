# Django Configuration
SECRET_KEY=django-insecure-ai-career-recommender-system-secret-key-production-ready
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for dev, PostgreSQL ready for prod)
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
